# ===== Genesis — required env vars =====

# Anthropic API key (used as LLM_API_KEY if LLM_API_KEY is not set)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM config — OpenAI-compatible format.
# Leave LLM_BASE_URL blank to use the Anthropic API directly via ANTHROPIC_API_KEY.
# Or set to a compatible gateway URL (e.g. hackathon proxy).
LLM_API_KEY=
LLM_BASE_URL=
# Simulation agent model (fast, high-volume)
LLM_MODEL_NAME=claude-sonnet-4-5
# Report / ontology / persona model (high-quality synthesis)
LLM_REPORT_MODEL_NAME=claude-opus-4-5

# Zep memory graph — free tier is enough for a demo: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Optional boost LLM (parallel simulation speed) =====
# If set, the reddit sim uses this as a second model so both platforms
# can run in parallel without rate-limiting each other.
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=
